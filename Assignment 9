print("\nQ3.2(a) Extract Words with More Than 5 Letters:")
long_words = re.findall(r'\b[A-Za-z]{6,}\b', text)
print(long_words)

print("\nQ3.2(b) Extract All Numbers:")
numbers = re.findall(r'\b\d+(?:\.\d+)?\b', text)
print(numbers)

print("\nQ3.2(c) Extract All Capitalized Words:")
capitalized_words = re.findall(r'\b[A-Z][a-zA-Z]*\b', text)
print(capitalized_words)

print("\nQ3.3(a) Split Text into Words Containing Only Alphabets:")
alphabetic_words = re.findall(r'[A-Za-z]+', text)
print(alphabetic_words)

print("\nQ3.3(b) Extract Words Starting with a Vowel:")
vowel_words = [
    word for word in alphabetic_words
    if word[0].lower() in 'aeiou'
]
print(vowel_words)

 Q4: CUSTOM TOKENIZATION AND REGEX-BASED TEXT CLEANING

custom_text = """Technology isn't simple. State-of-the-art tools cost 3.14 dollars.
Contact us at student@example.com or visit https://example.com.
Call +91 9876543210 or 123-456-7890 for details."""

print("\nQ4.1 Original Text:")
print(custom_text)

def custom_tokenize(text):
    pattern = r"\d+\.\d+|\d+|[A-Za-z]+(?:[-'][A-Za-z]+)*"
    return re.findall(pattern, text)

print("\nQ4.2 Custom Tokenization:")
print(custom_tokenize(custom_text))

print("\nQ4.3(a) Replace Email Addresses with <EMAIL>:")
email_pattern = r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b'
email_cleaned = re.sub(email_pattern, '<EMAIL>', custom_text)
print(email_cleaned)

print("\nQ4.3(b) Replace URLs with <URL>:")
url_pattern = r'https?://[^\s]+|www\.[^\s]+'
url_cleaned = re.sub(url_pattern, '<URL>', email_cleaned)
print(url_cleaned)

print("\nQ4.3(c) Replace Phone Numbers with <PHONE>:")
phone_pattern = r'\+91\s?\d{10}\b|\b\d{3}-\d{3}-\d{4}\b'
final_cleaned_text = re.sub(phone_pattern, '<PHONE>', url_cleaned)
print(final_cleaned_text)

