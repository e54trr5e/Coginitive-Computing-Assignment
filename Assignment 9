
import re
import string
import nltk
import pandas as pd
import matplotlib.pyplot as plt
from nltk.tokenize import word_tokenize, sent_tokenize
from nltk.corpus import stopwords
from nltk.probability import FreqDist
from nltk.stem import PorterStemmer, LancasterStemmer, WordNetLemmatizer

nltk.download('punkt')
nltk.download('punkt_tab')
nltk.download('stopwords')
nltk.download('wordnet')
nltk.download('omw-1.4')

text = """Technology is changing the world rapidly. Artificial intelligence helps people solve difficult problems.
Python is a popular programming language used in data science and machine learning.
I enjoy learning new technologies because they make life easier and more productive.
In 2026, developers build state-of-the-art applications using intelligent tools.
Technology connects people and creates opportunities for students around the world"

Q1

print("\nQ1. Original Paragraph (5-6 Sentences):")
print(text)

clean_text = text.lower()
clean_text = clean_text.translate(str.maketrans('', '', string.punctuation))

print("\nQ1.1 Convert Text to Lowercase and Remove Punctuation:")
print(clean_text)

word_tokens = word_tokenize(clean_text)
sentence_tokens = sent_tokenize(text)

print("\nQ1.2(a) Tokenize Text into Words:")
print(word_tokens)

print("\nQ1.2(b) Tokenize Text into Sentences:")
print(sentence_tokens)

stop_words = set(stopwords.words('english'))
filtered_words = [
    word for word in word_tokens
    if word.isalpha() and word not in stop_words
]

print("\nQ1.3 Remove Stopwords:")
print(filtered_words)

frequency = FreqDist(filtered_words)

print("\nQ1.4 Word Frequency Distribution (Excluding Stopwords):")
print(frequency.most_common())

frequency.plot(10, title="Q1.4 Word Frequency Distribution")
plt.show()


Q2

print("\nQ2.1 Tokenized Words After Stopword Removal:")
print(filtered_words)

porter = PorterStemmer()
lancaster = LancasterStemmer()
lemmatizer = WordNetLemmatizer()

porter_results = [porter.stem(word) for word in filtered_words]
lancaster_results = [lancaster.stem(word) for word in filtered_words]
lemma_results = [lemmatizer.lemmatize(word) for word in filtered_words]

print("\nQ2.2(a) Porter Stemmer Results:")
print(porter_results)

print("\nQ2.2(b) Lancaster Stemmer Results:")
print(lancaster_results)

print("\nQ2.3 Lemmatization Results:")
print(lemma_results)

print("\nQ2.4 Comparison of Stemming and Lemmatization:")

comparison = pd.DataFrame({
    "Original Word": filtered_words,
    "Porter Stemmer": porter_results,
    "Lancaster Stemmer": lancaster_results,
    "WordNet Lemmatizer": lemma_results
})

print(comparison)


