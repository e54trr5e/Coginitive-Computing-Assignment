import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

sns.set_style("whitegrid")

# ============================================================
# Q1: E-COMMERCE SALES DATA ANALYSIS
# ============================================================

# ---------------- PART I: RANDOMIZED SALES DATA GENERATION ----------------

# 1. Initialize random seed using roll number
roll_no = 123  # Replace 123 with your actual roll number
np.random.seed(roll_no)

print("=" * 60)
print("Q1: E-COMMERCE SALES DATA ANALYSIS")
print("=" * 60)

# 2. Generate sales data for 12 months and 4 categories
sales_data = np.random.randint(1000, 5001, size=(12, 4))

# 3. Convert NumPy array into Pandas DataFrame
months = [
    "Jan", "Feb", "Mar", "Apr", "May", "Jun",
    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
]

categories = [
    "Electronics", "Clothing", "Home & Kitchen", "Sports"
]

df = pd.DataFrame(
    sales_data,
    index=months,
    columns=categories
)

print("\nOriginal Sales Data:")
print(df)

# ---------------- PART II: DATA MANIPULATION AND ANALYSIS ----------------

# 1. Display first five rows and summary statistics
print("\nFirst Five Rows:")
print(df.head())

print("\nSummary Statistics:")
print(df.describe())

# 2. Calculate total sales per category and per month
print("\nTotal Sales Per Category:")
print(df[categories].sum(axis=0))

print("\nTotal Sales Per Month:")
print(df[categories].sum(axis=1))

# 3. Calculate average sales growth for each category
category_growth = df[categories].pct_change() * 100

print("\nAverage Monthly Sales Growth (%) Per Category:")
print(category_growth.mean())

# 4. Add Total Sales and Growth Rate columns
df["Total Sales"] = df[categories].sum(axis=1)
df["Growth Rate"] = df["Total Sales"].pct_change() * 100

print("\nDataFrame with Total Sales and Growth Rate:")
print(df.round(2))

# 5. Apply discount based on roll number
if roll_no % 2 == 0:
    df["Electronics"] = df["Electronics"] * 0.90
    print("\n10% discount applied to Electronics.")
else:
    df["Clothing"] = df["Clothing"] * 0.85
    print("\n15% discount applied to Clothing.")

# Recalculate totals after discount
df["Total Sales"] = df[categories].sum(axis=1)
df["Growth Rate"] = df["Total Sales"].pct_change() * 100

print("\nFinal Sales Data After Discount:")
print(df.round(2))

# ---------------- PART III: VISUALIZATIONS ----------------

# 1. Monthly sales trends for each category
plt.figure(figsize=(12, 6))

for category in categories:
    sns.lineplot(
        x=df.index,
        y=df[category],
        marker="o",
        label=category
    )

plt.title("Monthly Sales Trends by Product Category")
plt.xlabel("Month")
plt.ylabel("Sales Units")
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.show()

# 2. Box plots showing sales distribution
plt.figure(figsize=(10, 6))

sns.boxplot(data=df[categories], palette="Set2")

plt.title("Sales Distribution by Product Category")
plt.xlabel("Product Category")
plt.ylabel("Sales Units")
plt.grid(axis="y")
plt.tight_layout()
plt.show()


