# ============================================================
# Q5: SWAP TWO ELEMENTS IN A SET BY CONVERTING IT TO A LIST
# ============================================================

print("\n" + "=" * 60)
print("Q5: SWAPPING ELEMENTS IN A SET")
print("=" * 60)

my_set = {10, 20, 30, 40, 50}

print("\nOriginal Set:", my_set)

# Convert set into a list
my_list = list(my_set)

# Swap first and third elements
my_list[0], my_list[2] = my_list[2], my_list[0]

print("List After Swapping:", my_list)

# Convert the list back into a set
my_set = set(my_list)

print("Set After Converting Back:", my_set)

