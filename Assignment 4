6- def score_query_with_ties(query, df):
    query_words = set(query.lower().split())
    results = []

    for index, row in df.iterrows():
        keyword_words = set(row["keywords"].lower().split())
        score = len(query_words.intersection(keyword_words))

        if score > 0:
            results.append({
                "index": index,
                "question": row["question"],
                "answer": row["answer"],
                "category": row["category"],
                "score": score
            })

    if not results:
        print("No matching entries found.")
        return

    highest_score = max(r["score"] for r in results)

    best_matches = [
        r for r in results
        if r["score"] == highest_score
    ]

    if len(best_matches) > 1:
        print("\nTie detected!")

    for r in best_matches:
        print("\nQuestion:", r["question"])
        print("Answer:", r["answer"])
        print("Category:", r["category"])
        print("Score:", r["score"])


print("\nQ6: Tie example")
score_query_with_ties("fee", df)

print("\nQ6: No-tie example")
score_query_with_ties("password", df)
