4- Krrish = np.linspace(10, 100, 25)

print("Array:")
print(Krrish)

# Dimensions
print("\nDimensions:", Krrish.ndim)

# Shape
print("Shape:", Krrish.shape)

# Total elements
print("Total Elements:", Krrish.size)

# Data type
print("Data Type:", Krrish.dtype)

# Total bytes
print("Total Bytes:", Krrish.nbytes)

# Transpose using reshape
Krrish_reshaped = Krrish.reshape(25, 1)

print("\nArray reshaped to 25 x 1:")
print(Krrish_reshaped)

# Transpose using T attribute
print("\nTranspose using T attribute:")
print(Krrish_reshaped.T)

print("\nNote: T does not change a 1-D array directly.")
print("After converting it to 2-D using reshape(), T can transpose it.")


5- ucs420_Krrish = np.array([
    [10, 20, 30, 40],
    [50, 60, 70, 80],
    [90, 15, 20, 35]
])

print("Original 3 x 4 Array:")
print(ucs420_Krrish)

# Mean
print("\nMean:", np.mean(ucs420_Krrish))

# Median
print("Median:", np.median(ucs420_Krrish))

# Maximum
print("Maximum:", np.max(ucs420_Krrish))

# Minimum
print("Minimum:", np.min(ucs420_Krrish))

# Unique elements
print("Unique Elements:", np.unique(ucs420_Krrish))


# Reshape to 4 rows and 3 columns
reshaped_ucs420_Krrish = ucs420_Krrish.reshape(4, 3)

print("\nReshaped Array (4 x 3):")
