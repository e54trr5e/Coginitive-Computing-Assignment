import numpy as np

1- arr1 = np.array([10, 20, 30, 40, 50])

print("Original Array:", arr1)

# a) Addition of 2
print("After adding 2:", arr1 + 2)

# b) Multiply 3 with all elements
print("After multiplying by 3:", arr1 * 3)

# c) Divide every element by 2
print("After dividing by 2:", arr1 / 2)


2- (a) Reverse the array
arr = np.array([1, 2, 3, 6, 4, 5])

print("\nOriginal Array:", arr)
print("Reversed Array:", arr[::-1])


(b)(i) Most frequent value and indices in x
x = np.array([1, 2, 3, 4, 5, 1, 2, 1, 1, 1])

values, counts = np.unique(x, return_counts=True)
max_count = np.max(counts)

most_frequent = values[counts == max_count]

print("\nArray x:", x)
print("Most Frequent Value:", most_frequent)

for value in most_frequent:
    print("Indices of", value, ":", np.where(x == value)[0])


(b)(ii) Most frequent value and indices in y
y = np.array([1, 1, 1, 2, 3, 4, 2, 4, 3, 3])

values, counts = np.unique(y, return_counts=True)
max_count = np.max(counts)

most_frequent = values[counts == max_count]

print("\nArray y:", y)
print("Most Frequent Value:", most_frequent)

for value in most_frequent:
    print("Indices of", value, ":", np.where(y == value)[0])


