6- import pandas as pd

# Read the dataset
df = pd.read_csv("employees.csv")

# a) Shape of DataFrame
print("a) Shape of DataFrame:")
print(df.shape)


# b) Summary including data types and non-null counts
print("\nb) Summary of DataFrame:")
df.info()


# c) Descriptive statistics
print("\nc) Descriptive Statistics:")
print(df.describe())


# d) First 5 rows and last 3 rows
print("\nd) First 5 rows:")
print(df.head(5))

print("\nLast 3 rows:")
print(df.tail(3))


# e) Statistics

# i. Average salary
print("\ni) Average Salary:")
print(df["Salary"].mean())

# ii. Total bonus
print("\nii) Total Bonus:")
print(df["Bonus"].sum())

# iii. Youngest employee's age
print("\niii) Youngest Employee Age:")
print(df["Age"].min())

# iv. Highest performance rating
print("\niv) Highest Performance Rating:")
print(df["Rating"].max())


# f) Sort by Salary in descending order
print("\nf) DataFrame sorted by Salary:")
sorted_df = df.sort_values(by="Salary", ascending=False)
print(sorted_df)


# g) Add Performance Category column

def performance_category(rating):
    if rating >= 4.5:
        return "Excellent"
    elif rating >= 4.0:
        return "Good"
    else:
        return "Average"

df["Performance_Category"] = df["Rating"].apply(performance_category)

print("\ng) Performance Category:")
print(df)


# h) Identify missing values
print("\nh) Missing Values:")
print(df.isnull().sum())


# i) Rename Employee_ID to ID
df = df.rename(columns={"Employee_ID": "ID"})

print("\ni) After renaming Employee_ID to ID:")
print(df)


# j) Find employees with more than 5 years of experience
print("\nj-i) Employees with more than 5 years of experience:")
print(df[df["Years_of_Experience"] > 5])


# j-ii) Find employees belonging to IT department
print("\nj-ii) Employees belonging to IT department:")
print(df[df["Department"] == "IT"])


# k) Add Tax column (10% of Salary)
df["Tax"] = df["Salary"] * 0.10

print("\nk) DataFrame with Tax:")
print(df)


# l) Save modified DataFrame to a new CSV file
df.to_csv("modified_employees.csv", index=False)

print("\nl) Modified DataFrame saved as modified_employees.csv")

