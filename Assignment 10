
import re
import nltk
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from collections import Counter
from nltk.tokenize import word_tokenize, sent_tokenize
from nltk.corpus import stopwords
from nltk.stem import PorterStemmer, WordNetLemmatizer
from sklearn.feature_extraction.text import CountVectorizer, TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity
from textblob import TextBlob
from wordcloud import WordCloud
from tensorflow.keras.preprocessing.text import Tokenizer
from tensorflow.keras.preprocessing.sequence import pad_sequences
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Embedding, LSTM, Dense

nltk.download('punkt')
nltk.download('punkt_tab')
nltk.download('stopwords')
nltk.download('wordnet')
nltk.download('omw-1.4')

stop_words = set(stopwords.words('english'))

 Q1

text = """Technology is changing our lives every day. Artificial intelligence helps people solve complex problems.
Python is a popular programming language used in data science and machine learning.
I enjoy learning new technologies because they make life easier and more productive.
Modern computers process large amounts of information quickly.
Technology connects people and creates opportunities for students around the world."""

print("\nQ1. Original Paragraph:\n", text)

clean_text = re.sub(r'[^\w\s]', '', text.lower())
print("\nQ1.1 Lowercase Text Without Punctuation:\n", clean_text)

words = word_tokenize(clean_text)
sentences = sent_tokenize(text)

print("\nQ1.2(a) Word Tokenization:\n", words)
print("\nQ1.2(b) Sentence Tokenization:\n", sentences)

split_words = clean_text.split()
print("\nQ1.3(a) Python split():\n", split_words)
print("\nQ1.3(b) NLTK word_tokenize():\n", words)
print("\nComparison: split() separates text using whitespace, while word_tokenize() handles language tokenization more carefully.")

filtered_words = [w for w in words if w.isalpha() and w not in stop_words]
print("\nQ1.4 Words After Stopword Removal:\n", filtered_words)

word_frequency = Counter(filtered_words)
print("\nQ1.5 Word Frequency Distribution:\n", word_frequency)

plt.figure(figsize=(10, 5))
pd.Series(word_frequency).sort_values(ascending=False).plot(kind='bar')
plt.title("Q1: Word Frequency Distribution")
plt.xlabel("Words")
plt.ylabel("Frequency")
