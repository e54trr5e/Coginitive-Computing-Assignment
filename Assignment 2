3- import random

# Create a list of 100 random numbers between 100 and 900
numbers = [random.randint(100, 900) for i in range(100)]

# Function to check whether a number is prime
def is_prime(n):
    if n < 2:
        return False

    for i in range(2, int(n ** 0.5) + 1):
        if n % i == 0:
            return False

    return True


# Find odd numbers
odd_numbers = [n for n in numbers if n % 2 != 0]

# Find even numbers
even_numbers = [n for n in numbers if n % 2 == 0]

# Find prime numbers
prime_numbers = [n for n in numbers if is_prime(n)]

print("Random numbers:", numbers)

print("\nOdd numbers:")
print(odd_numbers)
print("Count of odd numbers:", len(odd_numbers))

print("\nEven numbers:")
print(even_numbers)
print("Count of even numbers:", len(even_numbers))

print("\nPrime numbers:")
print(prime_numbers)
print("Count of prime numbers:", len(prime_numbers))

4- # Create the sets
A = {34, 56, 78, 90}
B = {78, 45, 90, 23}

# i. Union of sets
print("Unique scores of both teams:", A.union(B))

# ii. Intersection of sets
print("Common scores:", A.intersection(B))

# iii. Symmetric difference
print("Exclusive scores of each team:", A.symmetric_difference(B))

# iv. Check subset and superset
print("Is A a subset of B?", A.issubset(B))
print("Is B a superset of A?", B.issuperset(A))

# v. Remove a specific score X from set A
X = int(input("Enter the score to remove from set A: "))

if X in A:
    A.remove(X)
    print("Score removed successfully.")
    print("Updated set A:", A)
else:
    print("Score is not present in set A.")

