import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

data = {
    "Subject": ["Python", "Java", "DBMS", "OS", "Maths"],
    "Score": [85, 78, 90, 82, 88]
}

df = pd.DataFrame(data)
print(df)

sns.barplot(
    data=df,
    x="Subject",
    y="Score",
    hue="Subject",
    palette="Set2",
    legend=False
)

for i, score in enumerate(df["Score"]):
    plt.text(i, score + 1, str(score), ha="center")

plt.title("Scores in Five Subjects")
plt.xlabel("Subjects")
plt.ylabel("Scores")
plt.ylim(0, 100)
plt.grid(axis="y", linestyle="--", alpha=0.5)

plt.show()


