import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

# Read the dataset from GitHub
url = "https://raw.githubusercontent.com/AnjulaMehto/MCA/main/company_sales_data.csv"
df = pd.read_csv(url)

print(df.head())

sns.set_style("whitegrid")

# 1. Line plot of total profit for all months
plt.figure(figsize=(10, 5))
sns.lineplot(data=df, x="month_number", y="total_profit",
             marker="o", color="blue")

plt.title("Total Profit of All Months")
plt.xlabel("Month Number")
plt.ylabel("Total Profit")
plt.grid(True)
plt.show()

# 2. Multiline plot for all product sales
products = [
    "facecream", "facewash", "toothpaste",
    "bathingsoap", "shampoo", "moisturizer"
]

plt.figure(figsize=(12, 6))

for product in products:
    sns.lineplot(data=df, x="month_number", y=product,
                 marker="o", label=product)

plt.title("Monthly Sales of All Products")
plt.xlabel("Month Number")
plt.ylabel("Units Sold")
plt.legend()
plt.grid(True)
plt.show()

# 3. Bar charts for all numerical features
features = df.select_dtypes(include="number").columns

fig, axes = plt.subplots(3, 3, figsize=(15, 12))
axes = axes.flatten()

for i, feature in enumerate(features):
    sns.barplot(data=df, x="month_number", y=feature,
                ax=axes[i], color="skyblue")
    axes[i].set_title(feature.replace("_", " ").title())
    axes[i].set_xlabel("Month")
    axes[i].set_ylabel(feature)
    axes[i].tick_params(axis="x", rotation=45)

# Hide unused subplot spaces
for j in range(len(features), len(axes)):
    axes[j].set_visible(False)

plt.tight_layout()
plt.show()
