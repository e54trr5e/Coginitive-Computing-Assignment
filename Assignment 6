import numpy as np
import matplotlib.pyplot as plt

roll_no = 123
np.random.seed(roll_no)

data = np.random.randn(50)
x = np.arange(1, 51)

fig, ax = plt.subplots(2, 2, figsize=(10, 8))

# 1. Line plot
ax[0, 0].plot(x, data, color="blue")
ax[0, 0].set_title("Random Values")
ax[0, 0].set_xlabel("Index")
ax[0, 0].set_ylabel("Value")
ax[0, 0].grid(True)

# 2. Cumulative sum plot
ax[0, 1].plot(x, np.cumsum(data), color="green")
ax[0, 1].set_title("Cumulative Sum")
ax[0, 1].set_xlabel("Index")
ax[0, 1].set_ylabel("Cumulative Value")
ax[0, 1].grid(True)

# 3. Scatter plot with random noise
noise = np.random.randn(50)
ax[1, 0].scatter(data, noise, color="red")
ax[1, 0].set_title("Scatter Plot with Noise")
ax[1, 0].set_xlabel("Random Values")
ax[1, 0].set_ylabel("Noise")
ax[1, 0].grid(True)

# 4. Histogram
ax[1, 1].hist(data, bins=10, color="orange", edgecolor="black")
ax[1, 1].set_title("Histogram")
ax[1, 1].set_xlabel("Value")
ax[1, 1].set_ylabel("Frequency")
ax[1, 1].grid(True)

plt.tight_layout()
plt.show()


